{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prop-dd-calc/presets.schema.json",
  "title": "prop-dd-calc presets v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_date",
    "disclaimer",
    "status_values",
    "presets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.2.0"
      ]
    },
    "checked_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "disclaimer": {
      "type": "string"
    },
    "status_values": {
      "type": "object"
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "firm",
        "plan",
        "account_size",
        "status",
        "drawdown",
        "lock",
        "breach_on_touch",
        "breach_on_touch_after_lock",
        "daily_loss",
        "max_contracts",
        "source_url",
        "checked_date",
        "source_page_date",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{3}$"
        },
        "firm": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "account_size": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "custom_only"
          ]
        },
        "drawdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount_usd",
            "pct_of_start"
          ],
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "static",
                "eod_trailing",
                "intraday_trailing",
                null
              ]
            },
            "amount_usd": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "pct_of_start": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          }
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "offset_usd",
            "trail_trigger_balance_usd",
            "text"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "none",
                "offset",
                "payout_lock_to_start",
                "unstated"
              ]
            },
            "offset_usd": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "trail_trigger_balance_usd": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "breach_on_touch": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "breach_on_touch_after_lock": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "daily_loss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "amount_usd",
            "pct",
            "basis",
            "reset",
            "enforcement",
            "optional"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "none",
                "fixed_usd",
                "pct",
                "pct_of_start",
                "pct_choice",
                "unstated"
              ]
            },
            "amount_usd": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "pct": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?$",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            },
            "basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "reset": {
              "type": [
                "string",
                "null"
              ]
            },
            "enforcement": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "hard",
                "soft",
                null
              ]
            },
            "optional": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "max_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minis",
            "micros",
            "contracts",
            "micro_ratio_stated"
          ],
          "properties": {
            "minis": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "micros": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "contracts": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "micro_ratio_stated": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            }
          }
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "checked_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_page_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
